<?xml version="1.0" encoding="UTF-8"?>
<!-- Zigbee2MQTT Bridge Plugin - Actions.xml -->
<Actions>

    <!-- Set color temperature (lights only) -->
    <Action id="setColorTemperature" deviceFilter="self.z2mLight,self.z2mGroupLight" uiPath="DeviceActions">
        <Name>Set Color Temperature</Name>
        <ConfigUI>
            <Field id="kelvin" type="textfield" defaultValue="2700">
                <Label>Color Temperature (Kelvin):</Label>
                <Description>Warm white ~2700K  |  Neutral ~4000K  |  Daylight ~6500K</Description>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_set_color_temperature</CallbackMethod>
    </Action>

    <!-- Set brightness / position -->
    <Action id="setBrightness" deviceFilter="self.z2mLight,self.z2mCover,self.z2mGroupLight" uiPath="DeviceActions">
        <Name>Set Brightness / Position</Name>
        <ConfigUI>
            <Field id="brightness" type="textfield" defaultValue="100">
                <Label>Level (0-100%):</Label>
                <Description>Lights: brightness level.  Covers: open position (0=closed, 100=open).</Description>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_set_brightness</CallbackMethod>
    </Action>

    <!-- Set cover position (covers only) -->
    <Action id="setCoverPosition" deviceFilter="self.z2mCover" uiPath="DeviceActions">
        <Name>Set Cover Position</Name>
        <ConfigUI>
            <Field id="position" type="textfield" defaultValue="50">
                <Label>Position (0-100):</Label>
                <Description>0 = fully closed, 100 = fully open.</Description>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_set_cover_position</CallbackMethod>
    </Action>

    <!-- Refresh device state (every stateful device type — re-requests the
         retained payload via .../get). Coordinator/button omitted: a coordinator
         has no friendly_name and a button is a stateless event source. -->
    <Action id="refreshState"
            deviceFilter="self.z2mLight,self.z2mRelay,self.z2mContactSensor,self.z2mOccupancySensor,self.z2mWaterLeakSensor,self.z2mTemperatureSensor,self.z2mSensor,self.z2mCover,self.z2mRepeater,self.z2mLock,self.z2mThermostat"
            uiPath="DeviceActions">
        <Name>Refresh Device State</Name>
        <CallbackMethod>action_refresh_state</CallbackMethod>
    </Action>

    <!-- Publish a custom JSON payload to the device's /set topic — the escape
         hatch for z2m device options the typed actions don't cover
         (sensitivity, LED indicator modes, calibration, child lock...). -->
    <Action id="publishCustom"
            deviceFilter="self.z2mLight,self.z2mGroupLight,self.z2mGroupRelay,self.z2mRelay,self.z2mContactSensor,self.z2mOccupancySensor,self.z2mWaterLeakSensor,self.z2mTemperatureSensor,self.z2mSensor,self.z2mCover,self.z2mButton,self.z2mLock,self.z2mThermostat"
            uiPath="DeviceActions">
        <Name>Publish Custom Payload</Name>
        <ConfigUI>
            <Field id="json_payload" type="textfield" defaultValue="{}">
                <Label>JSON payload:</Label>
            </Field>
            <Field id="label_json_payload_info" type="label">
                <Label>A JSON object published to zigbee2mqtt/&lt;device&gt;/set. Use z2m's snake_case property names, e.g. {"motion_sensitivity": "high"}. NB battery devices must be awake to receive it.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_publish_custom</CallbackMethod>
    </Action>

    <!-- Offered on every type of Zigbee device, because any of them may
         support over-the-air updates. The callback refuses anything whose
         definition says otherwise, and anything with no update pending.
         The deviceFilter is required, not a nicety: without one Indigo shows
         no device list and hands the callback no device, so every run could
         only log "no device given" (fixed 2.9.0). Coordinator and the
         split-out reading devices are left out — they are not radios that
         take an update, and carry no firmware states. -->
    <Action id="updateFirmware"
            deviceFilter="self.z2mLight,self.z2mRelay,self.z2mContactSensor,self.z2mOccupancySensor,self.z2mWaterLeakSensor,self.z2mTemperatureSensor,self.z2mSensor,self.z2mCover,self.z2mRepeater,self.z2mButton,self.z2mLock,self.z2mThermostat"
            uiPath="DeviceActions">
        <Name>Update Device Firmware</Name>
        <CallbackMethod>action_update_firmware</CallbackMethod>
        <ConfigUI>
            <Field id="when" type="menu" defaultValue="now">
                <Label>Install:</Label>
                <List>
                    <Option value="now">Now</Option>
                    <Option value="next">The next time the device asks (best for battery devices)</Option>
                </List>
            </Field>
            <Field id="warning" type="label" fontColor="orange">
                <Label>Starts a firmware update over the air. It can take several minutes, the device will be unresponsive throughout, and interrupting it can leave the device unusable. Run "Check for Firmware Updates" first — this does nothing unless an update is actually waiting.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <!-- v2.13.0 -->
    <Action id="stopCover" deviceFilter="self.z2mCover" uiPath="DeviceActions">
        <Name>Stop Blind</Name>
        <CallbackMethod>action_stop_cover</CallbackMethod>
    </Action>

    <Action id="fadeLight" deviceFilter="self.z2mLight,self.z2mGroupLight" uiPath="DeviceActions">
        <Name>Fade Light to Brightness</Name>
        <ConfigUI>
            <Field id="brightness" type="textfield" defaultValue="100">
                <Label>Brightness (0-100%):</Label>
            </Field>
            <Field id="seconds" type="textfield" defaultValue="5">
                <Label>Over (seconds):</Label>
            </Field>
            <Field id="label_fade_info" type="label" fontSize="small">
                <Label>The bulb changes gradually over the time given. 0% fades it off. Most Zigbee bulbs can fade; one that cannot simply changes at once.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_fade_light</CallbackMethod>
    </Action>

    <!-- v2.16.0 -->
    <Action id="cancelFirmware"
            deviceFilter="self.z2mLight,self.z2mRelay,self.z2mContactSensor,self.z2mOccupancySensor,self.z2mWaterLeakSensor,self.z2mTemperatureSensor,self.z2mSensor,self.z2mCover,self.z2mRepeater,self.z2mButton,self.z2mLock,self.z2mThermostat"
            uiPath="DeviceActions">
        <Name>Cancel Device Firmware Update</Name>
        <CallbackMethod>action_cancel_firmware</CallbackMethod>
        <ConfigUI>
            <Field id="label_cancel_info" type="label" fontSize="small">
                <Label>Cancels a scheduled update, or stops one that is installing. The device stays on its old firmware.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <!-- v2.15.0: Zigbee scenes, kept in the bulbs themselves. -->
    <Action id="recallScene" deviceFilter="self.z2mGroupLight,self.z2mGroupRelay,self.z2mLight" uiPath="DeviceActions">
        <Name>Recall Zigbee Scene</Name>
        <ConfigUI>
            <Field id="scene" type="menu">
                <Label>Scene:</Label>
                <List class="self" method="list_device_scenes" dynamicReload="true"/>
            </Field>
            <Field id="label_recall_info" type="label" fontSize="small">
                <Label>Every light puts itself back as the scene stored it, all at once.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_recall_scene</CallbackMethod>
    </Action>

    <Action id="storeScene" deviceFilter="self.z2mGroupLight,self.z2mGroupRelay,self.z2mLight" uiPath="DeviceActions">
        <Name>Store Zigbee Scene</Name>
        <ConfigUI>
            <Field id="scene" type="menu" defaultValue="new">
                <Label>Scene:</Label>
                <List class="self" filter="store" method="list_device_scenes" dynamicReload="true"/>
            </Field>
            <Field id="sceneName" type="textfield" defaultValue="">
                <Label>Name:</Label>
            </Field>
            <Field id="label_store_info" type="label" fontSize="small">
                <Label>Saves what the lights are doing right now — on or off, brightness and colour — into each light's own memory. Choose an existing scene to replace it. Leave Name blank to keep its name, or for a new scene to be called Scene and its number.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_store_scene</CallbackMethod>
    </Action>

    <Action id="removeScene" deviceFilter="self.z2mGroupLight,self.z2mGroupRelay,self.z2mLight" uiPath="DeviceActions">
        <Name>Remove Zigbee Scene</Name>
        <ConfigUI>
            <Field id="scene" type="menu">
                <Label>Scene:</Label>
                <List class="self" method="list_device_scenes" dynamicReload="true"/>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_remove_scene</CallbackMethod>
    </Action>

    <Action id="reconfigureDevice"
            deviceFilter="self.z2mLight,self.z2mRelay,self.z2mContactSensor,self.z2mOccupancySensor,self.z2mWaterLeakSensor,self.z2mTemperatureSensor,self.z2mSensor,self.z2mCover,self.z2mRepeater,self.z2mButton,self.z2mLock,self.z2mThermostat"
            uiPath="DeviceActions">
        <Name>Set Up Zigbee Device Again</Name>
        <CallbackMethod>action_reconfigure_device</CallbackMethod>
        <ConfigUI>
            <Field id="label_reconfigure_info" type="label" fontSize="small">
                <Label>Asks zigbee2mqtt to run the device's setup again — what it does when a device first pairs. It is the usual cure for a device that has stopped reporting. A battery device must be awake.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="sepBridgeTools"/>

    <Action id="backupBridge">
        <Name>Back Up zigbee2mqtt</Name>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_backup_info" type="label" fontSize="small">
                <Label>Saves zigbee2mqtt's settings and device list to the backup folder chosen in the plugin's Configure window. The file holds your Zigbee network key, so keep it private.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_backup</CallbackMethod>
    </Action>

    <Action id="checkRouters">
        <Name>Check zigbee2mqtt for Missing Routers</Name>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_check_routers</CallbackMethod>
    </Action>

    <Action id="networkMap">
        <Name>Report Zigbee Network Map</Name>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_map_info" type="label" fontSize="small">
                <Label>Writes a report to the log of which devices have no route or a weak one. A large network takes a few minutes and keeps every router busy meanwhile, so run it now and then.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_network_map</CallbackMethod>
    </Action>

    <Action id="restartBridge">
        <Name>Restart zigbee2mqtt</Name>
        <ConfigUI>
            <Field id="bridge" type="menu">
                <Label>zigbee2mqtt:</Label>
                <List class="self" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_restart_info" type="label" fontColor="orange">
                <Label>Every device on this zigbee2mqtt stops answering for about half a minute while it restarts.</Label>
            </Field>
        </ConfigUI>
        <CallbackMethod>action_restart_bridge</CallbackMethod>
    </Action>

</Actions>
