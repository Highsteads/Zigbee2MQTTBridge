<?xml version="1.0" encoding="UTF-8"?>
<!-- Zigbee2MQTT Bridge Plugin - MenuItems.xml -->
<MenuItems>
    <MenuItem id="discoverCreateDevices">
        <Name>Discover &amp; Create Devices</Name>
        <CallbackMethod>discover_create_devices</CallbackMethod>
    </MenuItem>
    <MenuItem id="sep1" isSeparator="true"/>
    <MenuItem id="createCoordinatorDevices">
        <Name>Create Coordinator Devices</Name>
        <CallbackMethod>create_coordinator_devices</CallbackMethod>
    </MenuItem>
    <MenuItem id="sepCoord" isSeparator="true"/>
    <MenuItem id="refreshBridgeDevices">
        <Name>Refresh Device List from MQTT</Name>
        <CallbackMethod>refresh_bridge_devices</CallbackMethod>
    </MenuItem>
    <MenuItem id="refreshDeviceCapabilities">
        <Name>Refresh Device Capabilities</Name>
        <CallbackMethod>refresh_device_capabilities</CallbackMethod>
    </MenuItem>
    <MenuItem id="reportOrphanedDevices">
        <Name>Report Orphaned Devices</Name>
        <CallbackMethod>report_orphaned_devices</CallbackMethod>
    </MenuItem>
    <MenuItem id="reportNetworkHealth">
        <Name>Report Network Health</Name>
        <CallbackMethod>report_network_health</CallbackMethod>
    </MenuItem>
    <MenuItem id="networkMapMenu">
        <Name>Report Network Map...</Name>
        <CallbackMethod>menu_network_map</CallbackMethod>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_map_info" type="label">
                <Label>zigbee2mqtt asks every router who it can hear, and the log then says which devices have no route or a weak one, and which routers the most devices rely on. It asks the routers a second apart, so a large network takes a few minutes — run it now and then, not on a schedule every hour.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="sepFirmware" isSeparator="true"/>
    <MenuItem id="checkFirmwareUpdates">
        <Name>Check for Firmware Updates</Name>
        <CallbackMethod>check_firmware_updates</CallbackMethod>
    </MenuItem>
    <MenuItem id="reportFirmwareStatus">
        <Name>Report Firmware Status</Name>
        <CallbackMethod>report_firmware_status</CallbackMethod>
    </MenuItem>
    <MenuItem id="updateFirmwareMenu">
        <Name>Update Device Firmware...</Name>
        <CallbackMethod>menu_update_firmware</CallbackMethod>
        <ConfigUI>
            <Field id="targetDevice" type="menu">
                <Label>Device:</Label>
                <List class="self" method="list_devices_with_updates" dynamicReload="true"/>
            </Field>
            <Field id="when" type="menu" defaultValue="now">
                <Label>Install:</Label>
                <List>
                    <Option value="now">Now</Option>
                    <Option value="next">The next time the device asks (best for battery devices)</Option>
                </List>
            </Field>
            <Field id="label_targetDevice_info" type="label">
                <Label>Only devices with an update waiting are listed. Run "Check for Firmware Updates" first if this is empty.</Label>
            </Field>
            <Field id="warning" type="label" fontColor="orange">
                <Label>The update runs over the air and takes several minutes. The device will be unresponsive throughout — do not switch it off at the wall while it is running, as an interrupted update can leave it unusable.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>

    <MenuItem id="cancelFirmwareMenu">
        <Name>Cancel Firmware Update...</Name>
        <CallbackMethod>menu_cancel_firmware</CallbackMethod>
        <ConfigUI>
            <Field id="targetDevice" type="menu">
                <Label>Device:</Label>
                <List class="self" method="list_devices_updating_or_scheduled" dynamicReload="true"/>
            </Field>
            <Field id="label_cancel_info" type="label">
                <Label>Cancels a scheduled update, or stops one that is installing. The device stays on its old firmware.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>

    <MenuItem id="sepBridgeTools" isSeparator="true"/>
    <MenuItem id="backupBridgeMenu">
        <Name>Back Up zigbee2mqtt...</Name>
        <CallbackMethod>menu_backup</CallbackMethod>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_backup_info" type="label">
                <Label>Saves zigbee2mqtt's settings and device list to the backup folder chosen in the plugin's Configure window, keeping the newest few. The file holds your Zigbee network key, so keep it private.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="checkRoutersMenu">
        <Name>Check for Missing Routers...</Name>
        <CallbackMethod>menu_check_routers</CallbackMethod>
        <ConfigUI>
            <Field id="bridge" type="menu" defaultValue="all">
                <Label>zigbee2mqtt:</Label>
                <List class="self" filter="all" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="reconfigureDeviceMenu">
        <Name>Set Up a Device Again...</Name>
        <CallbackMethod>menu_reconfigure_device</CallbackMethod>
        <ConfigUI>
            <Field id="targetDevice" type="menu">
                <Label>Device:</Label>
                <List class="self" method="list_radio_devices" dynamicReload="true"/>
            </Field>
            <Field id="label_reconfigure_info" type="label">
                <Label>Asks zigbee2mqtt to run the device's setup again — what it does when a device first pairs. It is the usual cure for a device that has stopped reporting. A battery device must be awake: press its button or set off its sensor first.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>
    <MenuItem id="restartBridgeMenu">
        <Name>Restart zigbee2mqtt...</Name>
        <CallbackMethod>menu_restart_bridge</CallbackMethod>
        <ConfigUI>
            <Field id="bridge" type="menu">
                <Label>zigbee2mqtt:</Label>
                <List class="self" method="list_bridge_prefixes" dynamicReload="true"/>
            </Field>
            <Field id="label_restart_info" type="label" fontColor="orange">
                <Label>Every device on this zigbee2mqtt stops answering for about half a minute while it restarts.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>

    <MenuItem id="sepJoin" isSeparator="true"/>
    <MenuItem id="permitJoinEnable">
        <Name>Enable Pairing (Permit Join, 254s)</Name>
        <CallbackMethod>permit_join_enable</CallbackMethod>
    </MenuItem>
    <MenuItem id="permitJoinDisable">
        <Name>Disable Pairing (Permit Join Off)</Name>
        <CallbackMethod>permit_join_disable</CallbackMethod>
    </MenuItem>
    <MenuItem id="sep2" isSeparator="true"/>
    <MenuItem id="toggleTimestamps">
        <Name>Toggle Timestamps in Log (on/off)</Name>
        <CallbackMethod>menuToggleTimestamps</CallbackMethod>
    </MenuItem>
    <MenuItem id="sep3" isSeparator="true"/>
    <MenuItem id="testMqttConnection">
        <Name>Test MQTT Connection</Name>
        <CallbackMethod>testMqttConnection</CallbackMethod>
    </MenuItem>
    <MenuItem id="showPluginInfo">
        <Name>Show Plugin Info</Name>
        <CallbackMethod>showPluginInfo</CallbackMethod>
    </MenuItem>
</MenuItems>
